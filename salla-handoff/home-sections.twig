{# Walaa Fadel home page, v4: ordered so a visitor understands the store in the first seconds and can buy fast.
   Order: banner (Walaa's intro + free-trial button) → about Walaa (slider) → إيش تحتاجي اليوم (4 ways in with starting prices)
   → ابدئي من هنا (real products with add-to-cart) → next gathering (no countdown) → private sessions
   → reviews (+ a quiet numbers line) → questions → closing.
   For a Salla theme started from Theme Raed: paste into src/views/pages/index.twig, put the images from
   assets/ in src/assets/images/ and walaa-redesign.css in src/assets/styles/ (import it after the theme styles).
   Add the fonts Readex Pro + IBM Plex Sans Arabic in master.twig.
   NOT yet run on Salla: check with `salla theme preview`. Product cards come from Salla's own
   salla-products-list so cart and checkout keep working; the CSS only restyles them.
   Replace: CATEGORY-ID (category id), CATEGORY-N-URL / ABOUT-PAGE-URL / FAQ-PAGE-URL / FREE-TRIAL-URL / ALL-PRODUCTS-URL (links),
   NEXT-NAME / NEXT-DATE / NEXT-DESC / NEXT-PRICE / NEXT-URL (next gathering), and the prices in `prices` below when they change. #}

{# Starting prices shown on the banner and the four boxes. Reference values from the store (Nov 2026); update by hand. #}
{% set prices = { recorded: '113.85', group: '299', private: '460' } %}

{% set strip %}
<div class="strip" aria-hidden="true"><div class="strip-track">
  {% for i in 1..2 %}
    {% for t in ['الجلسات المسجلة','اللقاءات الحضورية','الجلسات الخاصة','المفكرات والتدوين','التوكيدات','ساوند هيلينغ','تأمل وصوت'] %}
      <span>{{ t }}</span><svg viewBox="0 0 64 58"><path d="M32 45C16 38 19 19 32 6c13 13 16 32 0 39ZM32 45C15 46 5 33 6 18c17 2 27 12 26 27Zm0 0c17 1 27-12 26-27-17 2-27 12-26 27Z"/></svg>
    {% endfor %}
  {% endfor %}
</div></div>
{% endset %}


{# 1. Banner: the image is unchanged; the text now says exactly what is sold #}
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">أهلًا أنا ولاء فاضل</p>
      <h1 class="hero-title">وهنا مساحة تقتربي فيها من نفسك أكثر</h1>
      <p class="hero-lead">من الصوت والتأمل الذاتي إلى الكتابة والكوتشينغ، أقدم لك تجارب وأدوات مختلفة تساعدك تفهمي نفسك وتخصصي وقتًا لك بالطريقة اللي تناسبك.</p>
      <div class="hero-actions">
        <a class="btn btn-trial" href="FREE-TRIAL-URL">ابدئي بتجربة مجانية <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H4m6-6-6 6 6 6"/></svg></a>
      </div>
    </div>
    <div class="hero-art">
      <div class="hero-photo"><img src="{{ 'hero.jpg' | asset }}" alt="وعاء صوتي نحاسي على قماش طبيعي" fetchpriority="high"></div>
      <span class="chip-float chip-a">تستمعين في وقتك</span>
      <span class="chip-float chip-b">إتمام الطلب عبر سلة</span>
    </div>
  </div>
</section>
{{ strip|raw }}

{# 2. About Walaa, right under the banner #}
{# Slider: text slides on one side, photo cards on the other (photos from the Drive folder, no personal portrait).
   Edit the four slides in `about_slides`: title, text, button label, button link, photo file. #}
{% set about_slides = [
  {t:'أهلًا، أنا ولاء', d:'بدأت رحلتي في المختبرات الطبية، ثم قادني فضولي إلى الصحة الشمولية والصوت والكوتشينغ واكتشاف الذات.', b:'تعرّفي على ولاء', u:'ABOUT-PAGE-URL', i:'about-main.jpg'},
  {t:'الصوت والتأمل والكتابة', d:'من الصوت والتأمل الذاتي إلى الكتابة والكوتشينغ، أقدم لك تجارب وأدوات مختلفة تساعدك تفهمي نفسك وتخصصي وقتًا لك بالطريقة اللي تناسبك.', b:'تصفّحي الجلسات', u:'CATEGORY-1-URL', i:'about-3.jpg'},
  {t:'تجارب وأدوات تناسبك', d:'هنا أشاركك تجارب وأدوات تختارين منها ما يناسب مرحلتك.', b:'كل التجارب', u:'ALL-PRODUCTS-URL', i:'about-2.jpg'},
  {t:'بكل حب', d:'أساعدك بما يخدم مرحلتك الحالية… بكل حب.', b:'تعرّفي على ولاء', u:'ABOUT-PAGE-URL', i:'cover-journal.jpg'}
] %}
<section class="sec" id="about-home"><div class="wrap">
  <div class="ab">
    <div class="ab-rail" aria-label="اختاري الشريحة">
      {% for s in about_slides %}<button class="ab-dot" type="button" data-i="{{ loop.index0 }}" aria-label="{{ s.t }}"{% if loop.first %} aria-current="true"{% endif %}><span>{{ loop.index }}</span></button>{% endfor %}
    </div>
    <div class="ab-text">
      <p class="ab-kicker">تعرفي على ولاء</p>
      <div class="ab-slides">
        {% for s in about_slides %}<div class="ab-slide{% if loop.first %} is-on{% endif %}" aria-hidden="{{ loop.first ? 'false' : 'true' }}"><h2>{{ s.t }}</h2><p>{{ s.d }}</p><a class="btn btn-solid" href="{{ s.u }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ s.b }}</a></div>{% endfor %}
      </div>
    </div>
    <div class="ab-stage">
      {% for s in about_slides %}<button class="ab-card o{{ min(loop.index0, 3) }}" type="button" data-i="{{ loop.index0 }}" aria-label="{{ s.t }}" tabindex="-1"><img src="{{ s.i | asset }}" alt="" loading="lazy"></button>{% endfor %}
    </div>
  </div>
</div></section>
<script>
  // about slider: dots or cards change the slide
  (function () {
    var root = document.querySelector('.ab'); if (!root) return;
    var slides = root.querySelectorAll('.ab-slide'), cards = root.querySelectorAll('.ab-card'), dots = root.querySelectorAll('.ab-dot');
    function show(cur) {
      slides.forEach(function (s, k) { var on = k === cur; s.classList.toggle('is-on', on); s.setAttribute('aria-hidden', String(!on)); s.querySelector('a').tabIndex = on ? 0 : -1; });
      cards.forEach(function (c, k) { c.className = 'ab-card ' + (k < cur ? 'past' : 'o' + Math.min(k - cur, 3)); });
      dots.forEach(function (d, k) { if (k === cur) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
    }
    root.addEventListener('click', function (e) { var b = e.target.closest('[data-i]'); if (b) show(Number(b.dataset.i)); });
    show(0);
  })();
</script>
{# 3. Four ways in, each with its starting price #}
<section class="sec need-sec" id="choose">
  <img class="need-bg" src="{{ 'need-bg.jpg' | asset }}" alt="" aria-hidden="true" loading="lazy">
  <div class="wrap">
    <div class="need-head"><p class="need-kicker">مساحات ولاء</p><h2>إيش تحتاجي <span class="hl">اليوم؟</span></h2><span class="need-rule" aria-hidden="true"></span><p>اختاري المساحة الأقرب لك</p></div>
    {# Four cards: icon in a circle, title, short text, starting price, small button. The whole card is the link. #}
    {% set need_icons = {
      headphones: '<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.8"/><rect x="17" y="14" width="4" height="6" rx="1.8"/>',
      lotus: '<path d="M12 19c-3.6-1.7-4.7-5.9-2.6-9.9.9-1.7 1.9-2.9 2.6-3.6.7.7 1.7 1.9 2.6 3.6 2.1 4 1 8.2-2.6 9.9Z"/><path d="M12 19c-4.4.4-7.7-2.2-8.4-6.6 3.5-.3 6.3.9 7.8 3.3"/><path d="M12 19c4.4.4 7.7-2.2 8.4-6.6-3.5-.3-6.3.9-7.8 3.3"/><path d="M8 21.2h8"/>',
      pen: '<path d="M4.5 20.5 5.6 16 16.8 4.8a2 2 0 0 1 2.8 0l.6.6a2 2 0 0 1 0 2.8L9 19.4l-4.5 1.1Z"/><path d="m14.5 7.1 2.4 2.4"/>',
      heart: '<path d="M12 20.5s-7.5-4.6-7.5-10.2A4.2 4.2 0 0 1 12 7.8a4.2 4.2 0 0 1 7.5 2.5c0 5.6-7.5 10.2-7.5 10.2Z"/>'
    } %}
    <div class="need-grid">
      {% for c in [
        {t:'وقت لنفسي', d:'جلسات مسجلة وتوكيدات', s:'تبدأ من ' ~ prices.recorded ~ ' ر.س', u:'CATEGORY-1-URL', i:'headphones'},
        {t:'أعيش تجربة', d:'لقاءات حضورية جماعية', s:'تبدأ من ' ~ prices.group ~ ' ر.س', u:'CATEGORY-2-URL', i:'lotus'},
        {t:'أكتب وأكتشف', d:'مفكرات وتمارين تدوين', s:'قريبًا', u:'CATEGORY-3-URL', i:'pen'},
        {t:'مساحة خاصة', d:'جلسات فردية', s:'تبدأ من ' ~ prices.private ~ ' ر.س', u:'CATEGORY-4-URL', i:'heart'}
      ] %}
        <a class="need-card" href="{{ c.u }}"><span class="need-ico"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true">{{ need_icons[c.i]|raw }}</svg></span><strong>{{ c.t }}</strong><span class="need-text">{{ c.d }}</span><small>{{ c.s }}</small><span class="need-btn">اكتشفي</span></a>
      {% endfor %}
    </div>
  </div>
</section>

{# 4. Products right away, with Salla's own add-to-cart. Use the recorded-sessions category (or a "best sellers" one) #}
<section class="sec sec-lilac" id="start-here"><div class="wrap">
  <div class="sec-head"><div><h2>ابدئي من <span class="hl">هنا</span></h2><p class="sec-text">جلسات مسجلة تسمعينها في وقتك، تضيفينها للسلة بضغطة.</p></div><a class="more" href="CATEGORY-1-URL">كل الجلسات المسجلة</a></div>
  <salla-products-list source="categories" source-value="[CATEGORY-ID]" limit="4" class="products"></salla-products-list>
</div></section>

{# 5. Next gathering #}
<section class="sec"><div class="wrap">
  <div class="sec-head"><div><h2>عيشي تجربة <span class="hl">معنا</span></h2><p class="sec-text">لقاءات حضورية بمواعيد محددة. يُؤكَّد التوافر عند الحجز.</p></div><a class="more" href="CATEGORY-2-URL">كل اللقاءات</a></div>
  <div class="count-banner">
    <img class="count-side count-l" src="{{ 'event-left.jpg' | asset }}" alt="" loading="lazy">
    <div class="count-main">
      <p class="next-kicker">اللقاء القادم</p>
      <h2><span class="hl">NEXT-NAME</span></h2>
      <ul class="next-facts"><li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="3"/><path d="M8 3v4M16 3v4M4 10h16"/></svg> NEXT-DATE</li><li>NEXT-DESC</li><li>NEXT-PRICE ر.س</li></ul>
      <p>الموعد مرجعي، ويُؤكَّد التوافر عند الحجز.</p>
      <a class="btn btn-solid" href="NEXT-URL">التفاصيل والحجز</a>
    </div>
    <img class="count-side count-r" src="{{ 'event-right.jpg' | asset }}" alt="" loading="lazy">
  </div>
</div></section>

{# 6. Private sessions #}
<section class="sec"><div class="wrap">
  <div class="sec-head"><div><h2>مساحة <span class="hl">خاصة لكِ</span></h2><p class="sec-text">جلسات فردية، وقتها لكِ وحدك. يُنسَّق الموعد عند الحجز.</p></div><a class="more" href="CATEGORY-4-URL">كل الجلسات الخاصة</a></div>
  <div class="private-grid">
    <a class="tall" href="CATEGORY-4-URL"><img src="{{ 'need-private.jpg' | asset }}" alt="" loading="lazy"><span class="tall-cap"><strong>جلسة فردية</strong></span></a>
    <salla-products-list source="categories" source-value="[CATEGORY-ID]" limit="4" class="products products-2"></salla-products-list>
  </div>
</div></section>

{{ strip|raw }}

{# 7. Reviews first and prominent; the numbers are only a quiet line under them.
   The two quotes below are real excerpts from the current store's reviews. Add more as cards, or swap for Salla's {% component 'home.testimonials' %}. #}
<section class="sec sec-lilac" id="reviews"><div class="wrap">
  <div class="sec-head center"><div><h2>إيش قالوا <span class="hl">عن التجربة؟</span></h2></div></div>
  <div class="quotes">
    <figure class="quote"><svg class="q-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.4 6.2C6.2 7.3 4 10 4 13.6V18h5.8v-5.6H6.9c.1-2 1.2-3.5 3.1-4.2L9.4 6.2Zm9.6 0c-3.2 1.1-5.4 3.8-5.4 7.4V18h5.8v-5.6h-2.9c.1-2 1.2-3.5 3.1-4.2L19 6.2Z"/></svg><blockquote>أحب هالجلسات… وأسلوبها عسل وصوتها مريح للنفس</blockquote><figcaption>من تقييم زائرة في المتجر الحالي · 27 يوليو 2024</figcaption></figure>
    <figure class="quote"><svg class="q-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.4 6.2C6.2 7.3 4 10 4 13.6V18h5.8v-5.6H6.9c.1-2 1.2-3.5 3.1-4.2L9.4 6.2Zm9.6 0c-3.2 1.1-5.4 3.8-5.4 7.4V18h5.8v-5.6h-2.9c.1-2 1.2-3.5 3.1-4.2L19 6.2Z"/></svg><blockquote>شكرًا للمجهود ولاء</blockquote><figcaption>من تقييم زائرة في المتجر الحالي · 5 يوليو 2024</figcaption></figure>
  </div>
  <p class="trust-line"><span><b dir="ltr">5000+</b> عميل</span><i aria-hidden="true"></i><span><b dir="ltr">100+</b> جلسة حضورية</span></p>
</div></section>

{# 8. Questions #}
<section class="sec"><div class="wrap faq-layout">
  <div class="faq-col">
    <h2>أسئلة ممكن <span class="hl">تدور في بالك</span></h2>
    <div class="faq-list">
      <details><summary>كيف أختار التجربة المناسبة لي؟</summary><p>ابدئي من «إيش تحتاجي اليوم؟». اختاري جلسة مسجلة لمحتوى تستخدمينه في وقتك، أو لقاءً حضوريًا للتجربة الجماعية، أو مساحة خاصة لتجربة فردية.</p></details>
      <details><summary>ما الفرق بين المسجلة والحضورية والجلسات الخاصة؟</summary><p>المسجلة محتوى جاهز للاستماع؛ الحضورية تجربة جماعية بموعد ومكان محددين؛ والخاصة جلسة فردية. التفاصيل في صفحة كل منتج.</p></details>
      <details><summary>كيف أصل إلى الجلسات المسجلة بعد الشراء؟</summary><p>تصلك طريقة الوصول بعد إتمام الطلب، وتختلف من منتج لآخر؛ اقرئي تفاصيل كل جلسة.</p></details>
      <details><summary>هل هذه الجلسات بديل عن العلاج الطبي أو النفسي؟</summary><p>لا، هذه الجلسات ليست بديلًا للعلاج الطبي أو النفسي.</p></details>
    </div>
  </div>
  <aside class="faq-box"><h3>عندك سؤال ثاني؟</h3><p>اقرئي الأسئلة الشائعة كاملة، أو تواصلي معنا.</p><a class="btn btn-light" href="FAQ-PAGE-URL">كل الأسئلة</a></aside>
</div></section>

{# 9. Closing #}
<section class="sec sec-tight"><div class="wrap"><div class="closing">
  <h2>خذي وقتك لنفسك… وابدئي اليوم.</h2>
  <a class="btn btn-light" href="CATEGORY-1-URL">تصفّحي الجلسات</a>
</div></div></section>

