{# 2. About Walaa, right under the banner #}
{# Slider: text slides on one side, photo cards on the other (photos from the Drive folder, no personal portrait).
   Edit the four slides in `about_slides`: title, text, button label, button link, photo file. #}
{% set about_slides = [
  {t:'أهلًا، أنا ولاء', d:'بدأت رحلتي في المختبرات الطبية، ثم قادني فضولي إلى الصحة الشمولية والصوت والكوتشينغ واكتشاف الذات.', b:'تعرّفي على ولاء', u:'ABOUT-PAGE-URL', i:'about-main.jpg'},
  {t:'الصوت والتأمل والكتابة', d:'من الصوت والتأمل الذاتي إلى الكتابة والكوتشينغ، أقدم لك تجارب وأدوات مختلفة تساعدك تفهمي نفسك وتخصصي وقتًا لك بالطريقة اللي تناسبك.', b:'تصفّحي الجلسات', u:'CATEGORY-1-URL', i:'about-3.jpg'},
  {t:'تجارب وأدوات تناسبك', d:'هنا أشاركك تجارب وأدوات تختارين منها ما يناسب مرحلتك.', b:'كل التجارب', u:'ALL-PRODUCTS-URL', i:'about-2.jpg'},
  {t:'بكل حب', d:'أساعدك بما يخدم مرحلتك الحالية… بكل حب.', b:'تعرّفي على ولاء', u:'ABOUT-PAGE-URL', i:'cover-journal.jpg'}
] %}
<section class="sec" id="about-home"><div class="wrap">
  <div class="ab">
    <div class="ab-rail" aria-label="اختاري الشريحة">
      {% for s in about_slides %}<button class="ab-dot" type="button" data-i="{{ loop.index0 }}" aria-label="{{ s.t }}"{% if loop.first %} aria-current="true"{% endif %}><span>{{ loop.index }}</span></button>{% endfor %}
    </div>
    <div class="ab-text">
      <p class="ab-kicker">تعرفي على ولاء</p>
      <div class="ab-slides">
        {% for s in about_slides %}<div class="ab-slide{% if loop.first %} is-on{% endif %}" aria-hidden="{{ loop.first ? 'false' : 'true' }}"><h2>{{ s.t }}</h2><p>{{ s.d }}</p><a class="btn btn-solid" href="{{ s.u }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ s.b }}</a></div>{% endfor %}
      </div>
    </div>
    <div class="ab-stage">
      {% for s in about_slides %}<button class="ab-card o{{ min(loop.index0, 3) }}" type="button" data-i="{{ loop.index0 }}" aria-label="{{ s.t }}" tabindex="-1"><img src="{{ s.i | asset }}" alt="" loading="lazy"></button>{% endfor %}
    </div>
  </div>
</div></section>
<script>
  // about slider: dots or cards change the slide
  (function () {
    var root = document.querySelector('.ab'); if (!root) return;
    var slides = root.querySelectorAll('.ab-slide'), cards = root.querySelectorAll('.ab-card'), dots = root.querySelectorAll('.ab-dot');
    function show(cur) {
      slides.forEach(function (s, k) { var on = k === cur; s.classList.toggle('is-on', on); s.setAttribute('aria-hidden', String(!on)); s.querySelector('a').tabIndex = on ? 0 : -1; });
      cards.forEach(function (c, k) { c.className = 'ab-card ' + (k < cur ? 'past' : 'o' + Math.min(k - cur, 3)); });
      dots.forEach(function (d, k) { if (k === cur) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
    }
    root.addEventListener('click', function (e) { var b = e.target.closest('[data-i]'); if (b) show(Number(b.dataset.i)); });
    show(0);
  })();
</script>
